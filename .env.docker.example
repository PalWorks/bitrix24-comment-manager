# Copy to .env, fill in, then: docker compose up -d
#
# Every value below is read by docker-compose.yml. Compose refuses to start
# when a required one is missing, so a typo fails immediately and loudly rather
# than at the first request.

# ---- generate these two ----------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- database --------------------------------------------------------------
# Any strong values. Nothing outside the compose network sees them.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=b24_comments
MYSQL_USER=b24

# ---- your Bitrix24 application ---------------------------------------------
# From the local application you register on your portal.
# Walkthrough: docs/SETUP.md
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# Portals this backend will authenticate. Comma separated.
#   acme.bitrix24.com          one portal
#   acme.bitrix24.com,acme.de  several
#   *.bitrix24.com             any subdomain
BITRIX24_ALLOWED_PORTALS=

# ---- public address --------------------------------------------------------
# The https origin this backend answers on, as seen from the internet. It must
# match the redirect (handler) URI registered with your Bitrix24 application.
BACKEND_URL=https://api.example.com

# Your extension's ID, so the browser is allowed to call this backend.
# Find it at chrome://extensions with Developer mode on.
CORS_ORIGINS=chrome-extension://your-extension-id

# Which host interface to publish port 3000 on. The default keeps the backend
# on loopback so only a reverse proxy on the same machine can reach it. Set to
# 0.0.0.0 only if something else terminates TLS in front of it.
BIND_ADDRESS=127.0.0.1

# ---- support mailbox (optional) --------------------------------------------
# Only for the deployment that answers the extension's Get help form. A normal
# self hosted instance leaves all three empty and the support endpoint is off.
# Set all three or none: a partial configuration is rejected at startup.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=support@example.com
SUPPORT_TO_EMAIL=you@example.com

# ---- comment policy --------------------------------------------------------
MAX_COMMENT_LENGTH=5000
DUPLICATE_WINDOW_SECONDS=300
JWT_EXPIRY_SECONDS=3600

# How many reverse proxies sit in front of this server. One for a single TLS
# terminating proxy such as Caddy or nginx; two if Cloudflare's proxy is also
# in the path. It must match reality: too low and every client shares one rate
# limit bucket, too high and a client can forge its own address.
TRUST_PROXY=1
