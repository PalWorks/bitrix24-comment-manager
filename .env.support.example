# A support mailbox and nothing else. See docker-compose.support.yml.
#
#   cp .env.support.example .env.support
#   docker compose -f docker-compose.support.yml --env-file .env.support up -d

# From resend.com. Needs send permission on the domain below.
RESEND_API_KEY=

# The sender. Must be on a domain verified in Resend, which is usually a
# sending subdomain rather than your root domain. No inbox is needed here:
# replies go to the reporter through Reply-To, and only bounces arrive.
SUPPORT_FROM_EMAIL=Bitrix24 Comment Manager <BitrixCommentsManager@mail.example.com>

# Where support messages land. This one does need an inbox you read.
SUPPORT_TO_EMAIL=support@example.com

# Which extensions may post here. The published build's ID, comma separated.
# Leaving this open would let any page on the web post to your mailbox.
CORS_ORIGINS=chrome-extension://your-extension-id

# Largest attachment accepted, in bytes, measured after decoding. Default 5 MB.
SUPPORT_MAX_ATTACHMENT_BYTES=5242880

# Which host interface to publish on. The default keeps it on loopback so only
# a reverse proxy on the same machine can reach it.
BIND_ADDRESS=127.0.0.1
