# ---- server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin of this backend. Must match the redirect (handler) URI you
# registered with your Bitrix24 application.
BACKEND_URL=http://localhost:3000

# ---- authentication --------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-random-bytes
JWT_EXPIRY_SECONDS=3600

# ---- Bitrix24 OAuth2 -------------------------------------------------------
# From the local application you created on your Bitrix24 portal.
BITRIX24_CLIENT_ID=your-bitrix24-client-id
BITRIX24_CLIENT_SECRET=your-bitrix24-client-secret

# Which portals this backend will authenticate. Comma separated.
# Exact hosts:   acme.bitrix24.com,acme.bitrix24.de
# Wildcards:     *.bitrix24.com
# Any portal:    *          (only for a deliberately open, multi-tenant instance)
BITRIX24_ALLOWED_PORTALS=your-portal.bitrix24.com

# Single portal shorthand. When BITRIX24_ALLOWED_PORTALS is unset, this value
# becomes the allowlist. Setting either one is enough.
# BITRIX24_PORTAL_DOMAIN=your-portal.bitrix24.com

# ---- CORS ------------------------------------------------------------------
# Your extension's ID once published. Defaults to * with a warning in production.
CORS_ORIGINS=chrome-extension://your-extension-id

# ---- database --------------------------------------------------------------
# Required in production. MySQL 8+.
DATABASE_URL=mysql://user:password@localhost:3306/b24_comments

# Encrypts Bitrix24 refresh tokens at rest. Required in production.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-me-with-64-hex-characters

# ---- comment policy --------------------------------------------------------
MAX_COMMENT_LENGTH=5000
DUPLICATE_WINDOW_SECONDS=300

# ---- support mailbox (optional) --------------------------------------------
# Only the deployment that answers the extension's Get help form needs these.
# A normal self hosted instance leaves them empty and the /support endpoint
# reports itself unavailable. Set all three or none: a partial configuration is
# rejected at startup.
#
# The sender must be on a domain verified in Resend. Neither address is ever
# taken from a request, which is what stops a public form being a mail relay.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=Support <support@example.com>
SUPPORT_TO_EMAIL=you@example.com
SUPPORT_MAX_ATTACHMENT_BYTES=5242880
