# Optional. Build time only, read by Vite when building the extension.
#
# Sets the DEFAULT backend URL that the extension is seeded with on first run.
# Leave this file absent (or the value empty) to build an extension with no
# default, in which case users configure the backend URL on the options page.
#
# VITE_BACKEND_URL=https://api.example.com

# Optional. Build time only.
#
# Origin of the support service the extension's Get help form posts to. This is
# not a user setting: a support message is addressed to whoever publishes the
# build, so it must not be redirectable from the options page. A build without
# it hides the form and offers the GitHub issue tracker instead.
#
# Set this only on the official build. A fork should point it at its own
# support service or leave it empty.
#
# The official value lives in .env.production, which is committed: it is a
# public URL that has to be present in the store artifact, and passing it on the
# command line meant a build that forgot it shipped with the form silently
# hidden. Set it here only when building a fork.
#
# VITE_SUPPORT_URL=https://api.example.com
